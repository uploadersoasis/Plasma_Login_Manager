diff --git CMakeLists.txt CMakeLists.txt
index be80162..ec60397 100644
--- CMakeLists.txt
+++ CMakeLists.txt
@@ -4,6 +4,41 @@ set(PROJECT_VERSION "6.7.80")
 
 project(PLASMALOGIN VERSION ${PROJECT_VERSION})
 
+# The following is a workaround for a defect in glibc packages version 2.43.9000.359.gb507b6d4c.
+# Reverting to glibc version 2.43-797.1 or updating to a newer version eliminates this issue.
+# The following line instructs CMake to append "-D_GLIBCXX_BITS_SPECFUN_H=1" to each compiler invocation automatically.
+# The "D_GLIBCXX_BITS_SPECFUN_H=1" macro tells the libstdc++ headers that the
+# mathematical special functions have already been processed, preventing the
+# compiler from evaluating the broken "std::pow" expression so the build can complete.
+# Place the following line below the project() line.
+#add_compile_definitions(_GLIBCXX_BITS_SPECFUN_H=1)
+
+# pass explicit linker flags to strip all debug symbol information from the binaries regardless of build type
+# add_link_options() automatically propagates the flags to all executable, shared library, and module targets created in this directory and any subdirectories.
+#add_link_options("-Wl,-s")
+# pass explicit linker flags to strip all debug symbol information from the binaries but only when compiling the "Release" configuration
+#add_link_options("$<$<CONFIG:Release>:-Wl,-s>")
+# OR
+# append linker strip flags for debug symbols to the standard CMake linker variables
+# CMAKE_EXE_LINKER_FLAGS are assed to the compiler/linker driver when building executable binaries.
+# CMAKE_SHARED_LINKER_FLAGS are passed to the compiler/linker driver (like g++) when creating shared libraries (.so files).
+# CMAKE_MODULE_LINKER_FLAGS are passed to the compiler/linker driver when creating runtime-loaded plugins or modules.
+#set(CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS} -Wl,-s")
+#set(CMAKE_SHARED_LINKER_FLAGS "${CMAKE_SHARED_LINKER_FLAGS} -Wl,-s")
+#set(CMAKE_MODULE_LINKER_FLAGS "${CMAKE_MODULE_LINKER_FLAGS} -Wl,-s")
+# append linker strip flags for debug symbols to the CMake linker variables for the "Release" build type
+set(CMAKE_EXE_LINKER_FLAGS_RELEASE "${CMAKE_EXE_LINKER_FLAGS_RELEASE} -Wl,-s")
+set(CMAKE_SHARED_LINKER_FLAGS_RELEASE "${CMAKE_SHARED_LINKER_FLAGS_RELEASE} -Wl,-s")
+set(CMAKE_MODULE_LINKER_FLAGS_RELEASE "${CMAKE_MODULE_LINKER_FLAGS_RELEASE} -Wl,-s")
+# Do NOT set "CMAKE_STATIC_LINKER_FLAGS" or "CMAKE_STATIC_LINKER_FLAGS_RELEASE"
+# to "-Wl,-s" because those flags are passed to the archiver tool, e.g. "ar", which
+# bundles object files together without linking.
+# Because a static library is not a fully linked binary, it cannot process actual linker flags.
+# If building using static not shared dependencies, leaving "CMAKE_STATIC_LINKER_FLAGS"
+# or "CMAKE_STATIC_LINKER_FLAGS_RELEASE" empty is the correct approach, as the
+# final stripping of static archive symbols will happen automatically when they
+# are eventually linked into executables and shared libraries.
+
 # Options
 option(INSTALL_PAM_CONFIGURATION "Install PAM configuration files" ON)
 
@@ -89,7 +124,15 @@ set(CONFIG_DIR                  "${CMAKE_INSTALL_FULL_SYSCONFDIR}/plasmalogin.co
 set(SYSTEM_CONFIG_DIR           "${CMAKE_INSTALL_PREFIX}/lib/plasmalogin/plasmalogin.conf.d"      CACHE PATH      "Path of the system plasmalogin config directory")
 set(LOG_FILE                    "${CMAKE_INSTALL_FULL_LOCALSTATEDIR}/log/plasmalogin.log"  CACHE PATH      "Path of the plasmalogin log file")
 set(DBUS_CONFIG_FILENAME        "org.freedesktop.DisplayManager.conf"               CACHE STRING    "Name of the plasmalogin config file")
-set(PLASMALOGIN_INITIAL_VT             "1"                                                 CACHE STRING    "Initial tty to use")
+# Must set PLASMALOGIN_INITIAL_VT to use tty2 (or greater) since tty1 is used by getty@tty1.service to guarantee a rescue console as the first console.
+set(PLASMALOGIN_INITIAL_VT             "2"                                                 CACHE STRING    "Initial tty to use")
+
+# Force setting CMAKE_INSTALL_LIBEXECDIR and KDE_INSTALL_LIBEXECDIR are required to prevent installation of files into /usr/lib64/libexec .
+set(CMAKE_INSTALL_LIBEXECDIR "libexec" CACHE PATH "Library execution directory" FORCE)
+set(KDE_INSTALL_LIBEXECDIR "libexec" CACHE PATH "KDE execution directory" FORCE)
+
+# Skip .po files since they were removed.
+set(KF_SKIP_PO_PROCESSING "ON" CACHE PATH "Process Translation Files" FORCE)
 
 if(NOT DEFINED LOGIN_DEFS_PATH)
     set(LOGIN_DEFS_PATH "/etc/login.defs" CACHE PATH "Path to login.defs")
@@ -104,7 +147,8 @@ if (BUILD_TESTING)
     add_subdirectory(autotests)
 endif()
 
-ki18n_install(po)
+# Removed since the "po" subdirectory and its .po translation files were removed.
+#ki18n_install(po)
 
 # Display feature summary
 feature_summary(WHAT ALL FATAL_ON_MISSING_REQUIRED_PACKAGES)
